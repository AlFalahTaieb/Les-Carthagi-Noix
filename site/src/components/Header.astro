---
import { NAV, SITE } from '../config';
import Logo from './Logo.astro';
const actuel = Astro.url.pathname;
---
<header class="entete">
  <div class="conteneur barre">
    <a class="marque" href="/" aria-label={`${SITE.nom}, accueil`}>
      <Logo width="46" height="51" />
      <span>{SITE.nom}</span>
    </a>
    <div class="outils">
    <button class="theme" type="button" aria-label="Changer de thème (clair ou sombre)" title="Changer de thème">
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
        <defs><clipPath id="demi-gauche"><rect x="0" y="0" width="12" height="24" /></clipPath></defs>
        <path class="coque" d="M12 2C6.5 3.6 3 8.4 3 14c0 4.7 3.6 8 9 8s9-3.3 9-8c0-5.6-3.5-10.4-9-12Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
        <path class="moitie" d="M12 2C6.5 3.6 3 8.4 3 14c0 4.7 3.6 8 9 8s9-3.3 9-8c0-5.6-3.5-10.4-9-12Z" fill="currentColor" clip-path="url(#demi-gauche)" />
        <path d="M12 2v20" stroke="var(--creme)" stroke-width="1" />
      </svg>
    </button>
    <button class="burger" aria-expanded="false" aria-controls="menu" aria-label="Ouvrir le menu">
      <span></span><span></span><span></span>
    </button>
    </div>
    <nav id="menu" class="menu" aria-label="Navigation principale">
      <ul>
        {NAV.map((l) => (
          <li><a href={l.href} aria-current={actuel.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li><a class="bouton adhesion" href={SITE.adhesion}>Adhérer</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .entete { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--creme) 94%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--trait); }
  .barre { display: flex; align-items: center; justify-content: space-between; min-height: 4.5rem; gap: 1rem; }
  .marque { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--encre); font-family: var(--titre); font-size: 1.15rem; white-space: nowrap; }
  .menu ul { list-style: none; display: flex; align-items: center; gap: 1.75rem; margin: 0; padding: 0; }
  .menu a:not(.bouton) { color: var(--encre); text-decoration: none; padding-block: 0.4rem; border-bottom: 2px solid transparent; }
  .menu a:not(.bouton):hover, .menu a[aria-current] { border-bottom-color: var(--cuivre); }
  .adhesion { padding: 0.55em 1.2em; }
  .outils { display: flex; align-items: center; gap: 0.25rem; order: 3; }
  .menu { order: 2; margin-left: auto; margin-right: 0.75rem; }
  .theme { background: none; border: 0; padding: 0.5rem; cursor: pointer; color: var(--cuivre-texte); line-height: 0; border-radius: 50%; }
  .theme:hover { color: var(--encre); }
  .theme svg { transition: transform 0.5s cubic-bezier(.4,1.4,.5,1); }
  :global(:root[data-theme='dark']) .theme svg { transform: rotate(180deg); }
  .burger { display: none; background: none; border: 0; padding: 0.6rem; cursor: pointer; }
  .burger span { display: block; width: 1.6rem; height: 2px; background: var(--encre); margin: 5px 0; transition: transform 0.2s, opacity 0.2s; }

  @media (min-width: 52.01rem) and (max-width: 66rem) {
    .marque span { display: none; }
  }
  @media (max-width: 52rem) {
    .burger { display: block; }
    .menu { margin: 0; position: absolute; inset: 100% 0 auto 0; background: var(--creme); border-bottom: 1px solid var(--trait); display: none; }
    .menu.ouvert { display: block; }
    .menu ul { flex-direction: column; align-items: stretch; gap: 0; padding: 0.5rem 1.25rem 1.25rem; }
    .menu li { border-bottom: 1px solid var(--trait); }
    .menu a:not(.bouton) { display: block; padding: 0.9rem 0; border: 0; }
    .menu li:last-child { border: 0; padding-top: 1rem; }
    .adhesion { display: block; text-align: center; }
    .burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
    .burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>

<script>
  const racine = document.documentElement;
  const sombreActuel = () =>
    racine.dataset.theme ? racine.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  document.querySelector('.theme')?.addEventListener('click', () => {
    const suivant = sombreActuel() ? 'light' : 'dark';
    racine.dataset.theme = suivant;
    try { localStorage.setItem('theme', suivant); } catch {}
  });

  const bouton = document.querySelector<HTMLButtonElement>('.burger');
  const menu = document.getElementById('menu');
  bouton?.addEventListener('click', () => {
    const ouvert = menu?.classList.toggle('ouvert');
    bouton.setAttribute('aria-expanded', String(!!ouvert));
  });
</script>
