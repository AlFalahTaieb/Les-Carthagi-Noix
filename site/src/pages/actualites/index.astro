---
import Base from '../../layouts/Base.astro';
import { actualitesRecentes, dateSimple } from '../../utils';
const actus = await actualitesRecentes();
---
<Base titre="Actualités" description="Les nouvelles de l’association Les Carthagi’Noix.">
  <section class="section">
    <div class="conteneur">
      <p class="sur-titre">Actualités</p>
      <h1>Les nouvelles de l’association</h1>
      <span class="filet"></span>
      <ul class="actus">
        {actus.map((a) => (
          <li>
            <time datetime={a.data.date.toISOString()}>{dateSimple(a.data.date)}</time>
            <h2><a href={`/actualites/${a.id}/`}>{a.data.titre}</a></h2>
            <p>{a.data.resume}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .actus { list-style: none; padding: 0; margin: 2rem 0 0; max-width: 44rem; }
  .actus li { padding-block: 1.75rem; border-top: 1px solid var(--trait); }
  .actus time { font-size: 0.85rem; color: var(--cuivre-texte); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .actus h2 { font-size: 1.5rem; margin: 0.3rem 0 0.5rem; }
  .actus h2 a { color: var(--encre); text-decoration: none; }
  .actus h2 a:hover { color: var(--cuivre-texte); }
</style>
