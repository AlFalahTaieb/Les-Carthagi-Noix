---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { dateSimple } from '../../utils';

export async function getStaticPaths() {
  const actus = await getCollection('actualites');
  return actus.map((a) => ({ params: { id: a.id }, props: { a } }));
}
const { a } = Astro.props;
const { Content } = await render(a);
---
<Base titre={a.data.titre} description={a.data.resume}>
  <article class="section">
    <div class="conteneur lecture">
      <p class="sur-titre"><a href="/actualites/">← Actualités</a></p>
      <h1>{a.data.titre}</h1>
      <p class="date"><time datetime={a.data.date.toISOString()}>{dateSimple(a.data.date)}</time></p>
      <span class="filet"></span>
      {a.data.image && <img class="illus" src={a.data.image} alt="" />}
      <div class="prose"><Content /></div>
    </div>
  </article>
</Base>

<style>
  .sur-titre a { text-decoration: none; }
  .date { color: var(--cuivre-texte); font-weight: 600; }
  .illus { margin-block: 0 2rem; width: 100%; }
</style>
