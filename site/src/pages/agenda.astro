---
import Base from '../layouts/Base.astro';
import ListeEvenements from '../components/ListeEvenements.astro';
import { evenementsAVenir } from '../utils';
import { evenement, filAriane } from '../seo';
const donnees = [...(await evenementsAVenir()).map(evenement), filAriane([{ nom: 'Agenda', chemin: '/agenda/' }])];
---
<Base titre="Agenda culturel à Grenoble" description="Prochains événements de l’association culturelle Les Carthagi’Noix à Grenoble : inauguration, concerts, rencontres et club de musique orientale chaque vendredi." donnees={donnees}>
  <section class="section">
    <div class="conteneur">
      <p class="sur-titre">Agenda</p>
      <h1>Prochains rendez-vous</h1>
      <span class="filet"></span>
      <div class="rdv">
        <p class="sur-titre">Chaque semaine</p>
        <p><strong>Club de musique orientale</strong>, tous les vendredis de 18h à 20h à Grenoble. Ouvert à tous, débutants comme confirmés.</p>
      </div>
      <ListeEvenements />
    </div>
  </section>
</Base>

<style>
  .rdv { background: var(--creme-fonce); border-left: 3px solid var(--cuivre); padding: 1.25rem 1.5rem 0.4rem; margin-block: 1.5rem 2.5rem; max-width: 44rem; }
</style>
