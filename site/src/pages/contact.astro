---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
import Reseaux from '../components/Reseaux.astro';
import FormulaireContact from '../components/FormulaireContact.astro';
---
<Base titre="Contact et adhésion" description="Contacter l’association culturelle Les Carthagi’Noix à Grenoble par formulaire, adhérer via HelloAsso ou nous retrouver sur Instagram et Facebook.">
  <section class="section">
    <div class="conteneur lecture">
      <p class="sur-titre">Contact</p>
      <h1>Nous rejoindre</h1>
      <span class="filet"></span>
      <h2>Adhérer</h2>
      <p>L’adhésion se fait en ligne, en quelques minutes, via HelloAsso.</p>
      <p><a class="bouton" href={SITE.adhesion}>Adhérer à l’association</a></p>

      <h2>Nous écrire</h2>
      <p>Une question, une idée, une proposition de partenariat ? Écrivez-nous, nous vous répondrons rapidement.</p>
      <FormulaireContact />
      {SITE.email && <p>Vous pouvez aussi écrire directement à <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>}

      <h2>Suivez-nous</h2>
      <p>Actualités, coulisses et concerts : retrouvez-nous sur les réseaux.</p>
      <Reseaux libelle />
    </div>
  </section>
</Base>
