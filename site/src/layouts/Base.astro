---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

interface Props { titre?: string; description?: string; }
const { titre, description = SITE.description } = Astro.props;
const titreComplet = titre ? `${titre} · ${SITE.nom}` : `${SITE.nom} · ${SITE.devise}`;
const canonique = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f2e9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17140f" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <link rel="canonical" href={canonique} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/images/equipe.jpg', Astro.site)} />
    <meta property="og:locale" content="fr_FR" />
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu"><slot /></main>
    <Footer />
  </body>
</html>

<style is:global>
  .evitement { position: absolute; left: -999px; }
  .evitement:focus { left: 1rem; top: 1rem; background: var(--encre); color: var(--creme); padding: 0.5rem 1rem; z-index: 20; }
</style>
